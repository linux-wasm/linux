# SPDX-License-Identifier: GPL-2.0
# ===========================================================================
# Post-link wasm pass
# ===========================================================================
#
# Check that wasm-ld laid out the linker-table sections the way a linker
# script would have (see arch/wasm/kernel/sections.h).

PHONY := __archpost
__archpost:

-include include/config/auto.conf
include $(srctree)/scripts/Kbuild.include

quiet_cmd_check_sections = CHKSEC  vmlinux.map
      cmd_check_sections = \
	$(CONFIG_SHELL) $(srctree)/arch/wasm/tools/check-sections.sh vmlinux.map

vmlinux vmlinux.unstripped: FORCE
	$(call cmd,check_sections)

clean:
	@true

PHONY += FORCE clean

FORCE:

.PHONY: $(PHONY)
