# Merged by "make tinyconfig" on top of kernel/configs/tiny.config.
# A kernel that cannot print is of no use while the port is being brought up.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
# User space: an initramfs to load programs from and a tty for their output.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_WASM=y
CONFIG_TTY=y
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_DEVMEM is not set
