# WebAssembly (wasm32) architecture.
#
# Design notes (see also tools/wasm/NOTES.md):
#  - No MMU: the kernel lives in one flat wasm linear memory.
#  - Uniprocessor for now. SMP (one host thread per CPU) comes later.
#  - No loadable modules: there is no wasm dynamic loader in the kernel.
#  - Nothing here knows about browsers. Everything the kernel needs from
#    the outside world goes through the small import/export interface in
#    arch/wasm/include/asm/host.h.
#

config WASM
	def_bool y
	select ARCH_HAS_SYSCALL_WRAPPER
	select ARCH_NO_PREEMPT
	select ARCH_NO_SWAP
	select GENERIC_ATOMIC64
	select GENERIC_IRQ_SHOW
	select HAVE_ARCH_COMPILER_H
	select HAVE_PAGE_SIZE_4KB
	select NO_DMA
	select THREAD_INFO_IN_TASK
	select UACCESS_MEMCPY

config MMU
	def_bool n

config 64BIT
	def_bool n

config ARCH_FLATMEM_ENABLE
	def_bool y

config GENERIC_CSUM
	def_bool y

config GENERIC_HWEIGHT
	def_bool y

# No memory-mapped or port I/O: devices are reached through host calls.
config NO_IOMEM
	def_bool y

config NO_IOPORT_MAP
	def_bool y

# The kernel is linked by wasm-ld, which is neither ld.bfd nor an ELF lld:
# no linker scripts, no ELF sections. Generic code can test this symbol.
config LD_IS_WASMLD
	def_bool y

config NR_CPUS
	int
	default 1

config HZ
	int
	default 100

config GENERIC_CALIBRATE_DELAY
	def_bool n

config BINFMT_WASM
	bool "Kernel support for WebAssembly user programs"
	default y
	help
	  Run position-independent WebAssembly modules as user programs.
	  The user-space ABI is described in arch/wasm/kernel/binfmt_wasm.c.

config CMDLINE
	string "Built-in kernel command line"
	default ""
	help
	  Command line used when the host does not provide one.
